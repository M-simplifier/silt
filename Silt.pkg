      stdlib/core.silt
      stdlib/nat.silt
      stdlib/bytes.silt
      stdlib/text.silt
      stdlib/hosted.silt
      examples/hosted-echo.silt)
    (entry hosted-echo-main))
  (test stdlib-test
    (sources
      stdlib/core.silt
      stdlib/nat.silt
      stdlib/bytes.silt
      stdlib/text.silt
      stdlib/hosted.silt
      examples/hosted-hello.silt
      test/fixtures/stdlib/stdlib-tests.silt)
