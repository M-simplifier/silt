(claim stdlib-combinator-happy-test Bool)

(def
  stdlib-combinator-happy-test
  (bool-and
    (u64-eq stdlib-option-map-sample (u64 42))
    (bool-and
      (u64-eq stdlib-option-and-then-sample (u64 42))
      (bool-and
        (u64-eq stdlib-result-map-sample (u64 7))
        (bool-and
          (u64-eq stdlib-result-map-err-sample (u64 99))
          (bool-and
            (u64-eq stdlib-result-and-then-sample (u64 7))
            (u64-eq stdlib-list-tail-sample (u64 2))))))))

(claim stdlib-combinator-fallback-test Bool)

(def
  stdlib-combinator-fallback-test
  (bool-and
    (u64-eq stdlib-option-map-none-sample (u64 13))
    (bool-and
      (u64-eq stdlib-option-and-then-none-sample (u64 17))
      (bool-and
        (u64-eq stdlib-option-and-then-continuation-none-sample (u64 23))
        (bool-and
          (bool-not stdlib-result-map-error-preserve-sample)
          (bool-and
            (u64-eq stdlib-result-map-err-ok-sample (u64 7))
            (bool-and
              (bool-not stdlib-result-and-then-error-sample)
              (bool-and
                (bool-not stdlib-result-and-then-continuation-error-sample)
                (bool-and
                  (u64-eq stdlib-result-error-ok-sample (u64 77))
                  (u64-eq stdlib-list-tail-nil-sample (u64 55)))))))))))

(claim stdlib-combinator-test Bool)

(def
  stdlib-combinator-test
  (bool-and
    stdlib-combinator-happy-test
    (bool-and
      stdlib-combinator-fallback-test
      (bool-and
        (u64-eq stdlib-nat-add-sample (u64 5))
        (bool-and
          (u64-eq stdlib-nat-add-zero-left-sample (u64 2))
          (bool-and
            (u64-eq stdlib-nat-add-zero-right-sample (u64 2))
            (bool-and
              (u64-eq stdlib-nat-mul-sample (u64 6))
              (bool-and
                (u64-eq stdlib-nat-mul-zero-sample (u64 0))
                (u64-eq stdlib-nat-mul-zero-left-sample (u64 0))))))))))

(claim stdlib-test Bool)

(def
  stdlib-test
  (bool-and
    (u64-eq stdlib-option-sample (u64 42))
    (bool-and
      (u64-eq stdlib-result-sample (u64 7))
      (bool-and
        (u64-eq stdlib-list-sample (u64 9))
        (bool-and
          (u64-eq stdlib-text-len-sample (u64 5))
          (bool-and (u64-eq stdlib-nat-word-sample (u64 3)) stdlib-combinator-test))))))
