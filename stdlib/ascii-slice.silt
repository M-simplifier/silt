; ASCII predicates over explicit byte and text views.

; These helpers scan bytes only. They do not claim UTF-8 validation,

; Unicode categories, locale-sensitive behavior, or allocation.

(layout AsciiTrimState 24 8 ((found Bool 0) (start U64 8) (end U64 16)))

(claim ascii-trim-state (Pi ((found Bool) (start U64) (end U64)) AsciiTrimState))

(def
  ascii-trim-state
  (fn
    ((found Bool) (start U64) (end U64))
    (layout-values AsciiTrimState found start end)))

(claim
  ascii-trim-step
  (Pi ((index U64) (state AsciiTrimState) (byte U8)) AsciiTrimState))

(def
  ascii-trim-step
  (fn
    ((index U64) (state AsciiTrimState) (byte U8))
    (let-layout
      AsciiTrimState
      ((found found) (start start) (end end))
      state
      (match
        (ascii-byte-is-whitespace byte)
        ((True) (ascii-trim-state found start end))
        ((False)
         (match
           found
           ((False) (ascii-trim-state True index (u64-add index (u64 1))))
           ((True) (ascii-trim-state True start (u64-add index (u64 1))))))))))

(claim
  byte-slice-all-ascii-digits
  (Pi ((cap 0 Type) (bytes ByteSlice)) (Eff cap cap Bool)))

(def
  byte-slice-all-ascii-digits
  (fn
    ((cap 0 Type) (bytes ByteSlice))
    (nat-elim
      (Eff cap cap Bool)
      (pure cap Bool True)
      (fn
        ((index Nat) (rec (Eff cap cap Bool)))
        (bind
          cap
          cap
          cap
          Bool
          Bool
          rec
          (fn
            ((previous 1 Bool))
            (match
              previous
              ((False) (pure cap Bool False))
              ((True)
               (bind
                 cap
                 cap
                 cap
                 U8
                 Bool
                 (load cap U8 (byte-slice-at bytes (nat-to-u64 index)))
                 (fn ((byte 1 U8)) (pure cap Bool (ascii-byte-is-digit byte)))))))))
      (u64-to-nat (byte-slice-len bytes)))))

(claim
