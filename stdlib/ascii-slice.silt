  byte-slice-all-ascii-whitespace
  (fn
    ((cap 0 Type) (bytes ByteSlice))
    (nat-elim
      (Eff cap cap Bool)
      (pure cap Bool True)
      (fn
        ((index Nat) (rec (Eff cap cap Bool)))
