(claim text-all-ascii-digits (Pi ((cap 0 Type) (text TextView)) (Eff cap cap Bool)))

(def
  text-all-ascii-digits
  (fn
    ((cap 0 Type) (text TextView))
    (byte-slice-all-ascii-digits cap (byte-slice-from (text-base text) (text-len text)))))

(claim text-all-ascii-alnum (Pi ((cap 0 Type) (text TextView)) (Eff cap cap Bool)))

(def
  text-all-ascii-alnum
  (fn
    ((cap 0 Type) (text TextView))
    (byte-slice-all-ascii-alnum cap (byte-slice-from (text-base text) (text-len text)))))

