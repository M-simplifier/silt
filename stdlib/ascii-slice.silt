(claim
  byte-slice-trim-ascii-whitespace
  (Pi ((cap 0 Type) (bytes ByteSlice)) (Eff cap cap ByteSlice)))

(def
  byte-slice-trim-ascii-whitespace
  (fn
    ((cap 0 Type) (bytes ByteSlice))
    (bind
      cap
      cap
      cap
      AsciiTrimState
      ByteSlice
      (nat-elim
        (Eff cap cap AsciiTrimState)
        (pure
          cap
          AsciiTrimState
          (ascii-trim-state False (byte-slice-len bytes) (byte-slice-len bytes)))
        (fn
          ((index Nat) (rec (Eff cap cap AsciiTrimState)))
          (bind
            cap
            cap
            cap
            AsciiTrimState
            AsciiTrimState
            rec
            (fn
              ((state 1 AsciiTrimState))
              (bind
                cap
                cap
                cap
                U8
                AsciiTrimState
                (load cap U8 (byte-slice-at bytes (nat-to-u64 index)))
                (fn
                  ((byte 1 U8))
                  (pure
                    cap
                    AsciiTrimState
                    (ascii-trim-step (nat-to-u64 index) state byte)))))))
        (u64-to-nat (byte-slice-len bytes)))
      (fn
        ((state 1 AsciiTrimState))
        (let-layout
          AsciiTrimState
          ((found found) (start start) (end end))
          state
          (match
            found
            ((False)
             (pure
               cap
               ByteSlice
               (byte-slice-from
                 (ptr-step U8 (byte-slice-base bytes) (byte-slice-len bytes))
                 (u64 0))))
            ((True)
             (pure
               cap
               ByteSlice
               (byte-slice-from
                 (ptr-step U8 (byte-slice-base bytes) start)
                 (u64-sub end start))))))))))

(claim
  text-trim-ascii-whitespace
  (Pi ((cap 0 Type) (text TextView)) (Eff cap cap TextView)))

(def
  text-trim-ascii-whitespace
  (fn
    ((cap 0 Type) (text TextView))
    (bind
      cap
      cap
      cap
      ByteSlice
      TextView
      (byte-slice-trim-ascii-whitespace
        cap
        (byte-slice-from (text-base text) (text-len text)))
      (fn ((bytes 1 ByteSlice)) (pure cap TextView (text-from-bytes bytes))))))
