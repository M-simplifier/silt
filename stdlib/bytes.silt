; Byte-level library seed over the existing U8 / Ptr U8 substrate.

(layout ByteSlice 16 8 ((base (Ptr U8) 0) (len U64 8)))

(layout ByteFindResult 16 8 ((found Bool 0) (index U64 8)))

(layout ByteSplitFirst 40 8 ((found Bool 0) (before ByteSlice 8) (after ByteSlice 24)))

(claim byte-slice-from (Pi ((base (Ptr U8)) (len U64)) ByteSlice))

(def
  byte-slice-from
  (fn ((base (Ptr U8)) (len U64)) (layout-values ByteSlice base len)))

(claim byte-slice-base (Pi ((slice ByteSlice)) (Ptr U8)))

(def byte-slice-base (fn ((slice ByteSlice)) (field ByteSlice base slice)))

(claim byte-slice-len (Pi ((slice ByteSlice)) U64))

(def byte-slice-len (fn ((slice ByteSlice)) (field ByteSlice len slice)))

(claim byte-find-result (Pi ((found Bool) (index U64)) ByteFindResult))

(def
  byte-find-result
  (fn ((found Bool) (index U64)) (layout-values ByteFindResult found index)))

(claim byte-find-result-found (Pi ((result ByteFindResult)) Bool))

(def
  byte-find-result-found
  (fn ((result ByteFindResult)) (field ByteFindResult found result)))

(claim byte-find-result-index (Pi ((result ByteFindResult)) U64))

(def
  byte-find-result-index
  (fn ((result ByteFindResult)) (field ByteFindResult index result)))

(claim
  byte-split-first
  (Pi ((found Bool) (before ByteSlice) (after ByteSlice)) ByteSplitFirst))

(def
  byte-split-first
  (fn
    ((found Bool) (before ByteSlice) (after ByteSlice))
    (layout-values ByteSplitFirst found before after)))

(claim byte-split-first-found (Pi ((result ByteSplitFirst)) Bool))

(def
  byte-split-first-found
  (fn ((result ByteSplitFirst)) (field ByteSplitFirst found result)))

(claim byte-split-first-before (Pi ((result ByteSplitFirst)) ByteSlice))

(def
  byte-split-first-before
  (fn ((result ByteSplitFirst)) (field ByteSplitFirst before result)))

(claim byte-split-first-after (Pi ((result ByteSplitFirst)) ByteSlice))

(def
  byte-split-first-after
  (fn ((result ByteSplitFirst)) (field ByteSplitFirst after result)))

(claim byte-slice-at (Pi ((slice ByteSlice) (index U64)) (Ptr U8)))

(def
  byte-slice-at
  (fn ((slice ByteSlice) (index U64)) (ptr-step U8 (byte-slice-base slice) index)))

(claim byte-slice-is-empty (Pi ((slice ByteSlice)) Bool))

(def
  byte-slice-is-empty
  (fn ((slice ByteSlice)) (u64-eq (byte-slice-len slice) (u64 0))))

(claim byte-slice-take (Pi ((slice ByteSlice) (count U64)) ByteSlice))

(def
  byte-slice-take
  (fn
    ((slice ByteSlice) (count U64))
    (match
      (u64-lte count (byte-slice-len slice))
      ((False) slice)
      ((True) (byte-slice-from (byte-slice-base slice) count)))))

(claim byte-slice-drop (Pi ((slice ByteSlice) (count U64)) ByteSlice))

(def
  byte-slice-drop
  (fn
    ((slice ByteSlice) (count U64))
    (match
      (u64-lte count (byte-slice-len slice))
      ((False)
       (byte-slice-from
         (ptr-step U8 (byte-slice-base slice) (byte-slice-len slice))
         (u64 0)))
      ((True)
       (byte-slice-from
         (ptr-step U8 (byte-slice-base slice) count)
         (u64-sub (byte-slice-len slice) count))))))

(claim
  byte-slice-find-byte
  (Pi ((cap 0 Type) (bytes ByteSlice) (needle U8)) (Eff cap cap ByteFindResult)))

(def
  byte-slice-find-byte
  (fn
    ((cap 0 Type) (bytes ByteSlice) (needle U8))
    (nat-elim
      (Eff cap cap ByteFindResult)
      (pure cap ByteFindResult (byte-find-result False (byte-slice-len bytes)))
      (fn
        ((index Nat) (rec (Eff cap cap ByteFindResult)))
        (bind
          cap
          cap
          cap
          ByteFindResult
          ByteFindResult
          rec
          (fn
            ((previous 1 ByteFindResult))
            (let-layout
              ByteFindResult
              ((found found) (index found-index))
              previous
              (match
                found
                ((True) (pure cap ByteFindResult (byte-find-result True found-index)))
                ((False)
                 (bind
                   cap
                   cap
                   cap
                   U8
                   ByteFindResult
                   (load cap U8 (byte-slice-at bytes (nat-to-u64 index)))
                   (fn
                     ((byte 1 U8))
                     (match
                       (u8-eq byte needle)
                       ((False)
                        (pure cap ByteFindResult (byte-find-result False found-index)))
                       ((True)
                        (pure
                          cap
                          ByteFindResult
                          (byte-find-result True (nat-to-u64 index)))))))))))))
      (u64-to-nat (byte-slice-len bytes)))))

(claim
  byte-slice-contains-byte
  (Pi ((cap 0 Type) (bytes ByteSlice) (needle U8)) (Eff cap cap Bool)))

(def
  byte-slice-contains-byte
  (fn
    ((cap 0 Type) (bytes ByteSlice) (needle U8))
    (bind
      cap
      cap
      cap
      ByteFindResult
      Bool
      (byte-slice-find-byte cap bytes needle)
      (fn
        ((result 1 ByteFindResult))
        (let-layout
          ByteFindResult
          ((found found) (index 0 ignored-index))
          result
          (pure cap Bool found))))))

(claim
  byte-slice-split-first-byte
  (Pi ((cap 0 Type) (bytes ByteSlice) (needle U8)) (Eff cap cap ByteSplitFirst)))

(def
  byte-slice-split-first-byte
  (fn
    ((cap 0 Type) (bytes ByteSlice) (needle U8))
    (bind
      cap
      cap
      cap
      ByteFindResult
      ByteSplitFirst
      (byte-slice-find-byte cap bytes needle)
      (fn
        ((result 1 ByteFindResult))
        (let-layout
          ByteFindResult
          ((found found) (index index))
          result
          (match
            found
            ((False)
             (pure
               cap
               ByteSplitFirst
               (byte-split-first
                 False
                 bytes
                 (byte-slice-from
                   (ptr-step U8 (byte-slice-base bytes) (byte-slice-len bytes))
                   (u64 0)))))
            ((True)
             (pure
               cap
               ByteSplitFirst
               (byte-split-first
                 True
                 (byte-slice-take bytes index)
                 (byte-slice-drop bytes (u64-add index (u64 1))))))))))))

(claim
  byte-slice-split-first-lf
  (Pi ((cap 0 Type) (bytes ByteSlice)) (Eff cap cap ByteSplitFirst)))

(def
  byte-slice-split-first-lf
  (fn ((cap 0 Type) (bytes ByteSlice)) (byte-slice-split-first-byte cap bytes (u8 10))))

(claim
  byte-slice-count-byte
  (Pi ((cap 0 Type) (bytes ByteSlice) (needle U8)) (Eff cap cap U64)))

(def
  byte-slice-count-byte
  (fn
    ((cap 0 Type) (bytes ByteSlice) (needle U8))
    (nat-elim
      (Eff cap cap U64)
      (pure cap U64 (u64 0))
      (fn
        ((index Nat) (rec (Eff cap cap U64)))
        (bind
          cap
          cap
          cap
          U64
          U64
          rec
          (fn
            ((count 1 U64))
            (bind
              cap
              cap
              cap
              U8
              U64
              (load cap U8 (byte-slice-at bytes (nat-to-u64 index)))
              (fn
                ((byte 1 U8))
                (let
                  ((increment
                     (the
                       U64
                       (match (u8-eq byte needle) ((False) (u64 0)) ((True) (u64 1))))))
                  (pure cap U64 (u64-add count increment))))))))
      (u64-to-nat (byte-slice-len bytes)))))

(claim byte-slice-count-lf (Pi ((cap 0 Type) (bytes ByteSlice)) (Eff cap cap U64)))

(def
  byte-slice-count-lf
  (fn ((cap 0 Type) (bytes ByteSlice)) (byte-slice-count-byte cap bytes (u8 10))))

(claim
  byte-slice-eq
  (Pi ((cap 0 Type) (left ByteSlice) (right ByteSlice)) (Eff cap cap Bool)))

(def
  byte-slice-eq
  (fn
    ((cap 0 Type) (left ByteSlice) (right ByteSlice))
    (match
      (u64-eq (byte-slice-len left) (byte-slice-len right))
      ((False) (pure cap Bool False))
      ((True)
       (nat-elim
         (Eff cap cap Bool)
         (pure cap Bool True)
         (fn
           ((index Nat) (rec (Eff cap cap Bool)))
           (bind
             cap
             cap
             cap
             Bool
             Bool
             rec
             (fn
               ((previous 1 Bool))
               (match
                 previous
                 ((False) (pure cap Bool False))
                 ((True)
                  (bind
                    cap
                    cap
                    cap
                    U8
                    Bool
                    (load cap U8 (byte-slice-at left (nat-to-u64 index)))
                    (fn
                      ((left-byte 1 U8))
                      (bind
                        cap
                        cap
                        cap
                        U8
                        Bool
                        (load cap U8 (byte-slice-at right (nat-to-u64 index)))
                        (fn
                          ((right-byte 1 U8))
                          (pure cap Bool (u8-eq left-byte right-byte)))))))))))
         (u64-to-nat (byte-slice-len left)))))))

(claim
  byte-slice-starts-with
  (Pi ((cap 0 Type) (bytes ByteSlice) (prefix ByteSlice)) (Eff cap cap Bool)))

(def
  byte-slice-starts-with
  (fn
    ((cap 0 Type) (bytes ByteSlice) (prefix ByteSlice))
    (match
      (u64-lte (byte-slice-len prefix) (byte-slice-len bytes))
      ((False) (pure cap Bool False))
      ((True)
       (byte-slice-eq cap (byte-slice-take bytes (byte-slice-len prefix)) prefix)))))

(claim
  byte-slice-ends-with
  (Pi ((cap 0 Type) (bytes ByteSlice) (suffix ByteSlice)) (Eff cap cap Bool)))

(def
  byte-slice-ends-with
  (fn
    ((cap 0 Type) (bytes ByteSlice) (suffix ByteSlice))
    (match
      (u64-lte (byte-slice-len suffix) (byte-slice-len bytes))
      ((False) (pure cap Bool False))
      ((True)
       (byte-slice-eq
         cap
         (byte-slice-drop
           bytes
           (u64-sub (byte-slice-len bytes) (byte-slice-len suffix)))
         suffix)))))
