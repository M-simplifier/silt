; TextView is a byte view with an explicit unchecked text boundary.

; No UTF-8 validation or general string surface is claimed yet.

(layout TextView 16 8 ((base (Ptr U8) 0) (len U64 8)))

(layout TextSplitFirst 40 8 ((found Bool 0) (before TextView 8) (after TextView 24)))

(claim text-view-from (Pi ((base (Ptr U8)) (len U64)) TextView))

(def text-view-from (fn ((base (Ptr U8)) (len U64)) (layout-values TextView base len)))

(claim text-from-bytes (Pi ((bytes ByteSlice)) TextView))

(def
  text-from-bytes
  (fn
    ((bytes ByteSlice))
    (text-view-from (byte-slice-base bytes) (byte-slice-len bytes))))

(claim text-base (Pi ((text TextView)) (Ptr U8)))

(def text-base (fn ((text TextView)) (field TextView base text)))

(claim text-len (Pi ((text TextView)) U64))

(def text-len (fn ((text TextView)) (field TextView len text)))

(claim text-byte-at (Pi ((text TextView) (index U64)) (Ptr U8)))

(def
  text-byte-at
  (fn ((text TextView) (index U64)) (ptr-step U8 (text-base text) index)))

(claim
  text-split-first
  (Pi ((found Bool) (before TextView) (after TextView)) TextSplitFirst))

(def
  text-split-first
  (fn
    ((found Bool) (before TextView) (after TextView))
    (layout-values TextSplitFirst found before after)))

(claim text-split-first-found (Pi ((result TextSplitFirst)) Bool))

(def
  text-split-first-found
  (fn ((result TextSplitFirst)) (field TextSplitFirst found result)))

(claim text-split-first-before (Pi ((result TextSplitFirst)) TextView))

(def
  text-split-first-before
  (fn ((result TextSplitFirst)) (field TextSplitFirst before result)))

(claim text-split-first-after (Pi ((result TextSplitFirst)) TextView))

(def
  text-split-first-after
  (fn ((result TextSplitFirst)) (field TextSplitFirst after result)))

(claim text-is-empty (Pi ((text TextView)) Bool))

(def text-is-empty (fn ((text TextView)) (u64-eq (text-len text) (u64 0))))

(claim text-take (Pi ((text TextView) (count U64)) TextView))

(def
  text-take
  (fn
    ((text TextView) (count U64))
    (text-from-bytes
      (byte-slice-take (byte-slice-from (text-base text) (text-len text)) count))))

(claim text-drop (Pi ((text TextView) (count U64)) TextView))

(def
  text-drop
  (fn
    ((text TextView) (count U64))
    (text-from-bytes
      (byte-slice-drop (byte-slice-from (text-base text) (text-len text)) count))))

(claim text-eq (Pi ((cap 0 Type) (left TextView) (right TextView)) (Eff cap cap Bool)))

(def
  text-eq
  (fn
    ((cap 0 Type) (left TextView) (right TextView))
    (byte-slice-eq
      cap
      (byte-slice-from (text-base left) (text-len left))
      (byte-slice-from (text-base right) (text-len right)))))

(claim
  text-starts-with
  (Pi ((cap 0 Type) (text TextView) (prefix TextView)) (Eff cap cap Bool)))

(def
  text-starts-with
  (fn
    ((cap 0 Type) (text TextView) (prefix TextView))
    (byte-slice-starts-with
      cap
      (byte-slice-from (text-base text) (text-len text))
      (byte-slice-from (text-base prefix) (text-len prefix)))))

(claim
  text-ends-with
  (Pi ((cap 0 Type) (text TextView) (suffix TextView)) (Eff cap cap Bool)))

(def
  text-ends-with
  (fn
    ((cap 0 Type) (text TextView) (suffix TextView))
    (byte-slice-ends-with
      cap
      (byte-slice-from (text-base text) (text-len text))
      (byte-slice-from (text-base suffix) (text-len suffix)))))

(claim
  text-find-byte
  (Pi ((cap 0 Type) (text TextView) (needle U8)) (Eff cap cap ByteFindResult)))

(def
  text-find-byte
  (fn
    ((cap 0 Type) (text TextView) (needle U8))
    (byte-slice-find-byte cap (byte-slice-from (text-base text) (text-len text)) needle)))

(claim
  text-contains-byte
  (Pi ((cap 0 Type) (text TextView) (needle U8)) (Eff cap cap Bool)))

(def
  text-contains-byte
  (fn
    ((cap 0 Type) (text TextView) (needle U8))
    (byte-slice-contains-byte
      cap
      (byte-slice-from (text-base text) (text-len text))
      needle)))

(claim
  text-split-first-byte
  (Pi ((cap 0 Type) (text TextView) (needle U8)) (Eff cap cap TextSplitFirst)))

(def
  text-split-first-byte
  (fn
    ((cap 0 Type) (text TextView) (needle U8))
    (bind
      cap
      cap
      cap
      ByteSplitFirst
      TextSplitFirst
      (byte-slice-split-first-byte
        cap
        (byte-slice-from (text-base text) (text-len text))
        needle)
      (fn
        ((result 1 ByteSplitFirst))
        (let-layout
          ByteSplitFirst
          ((found found) (before before) (after after))
          result
          (pure
            cap
            TextSplitFirst
            (text-split-first found (text-from-bytes before) (text-from-bytes after))))))))

(claim
  text-split-first-lf
  (Pi ((cap 0 Type) (text TextView)) (Eff cap cap TextSplitFirst)))

(def
  text-split-first-lf
  (fn ((cap 0 Type) (text TextView)) (text-split-first-byte cap text (u8 10))))

(claim
  text-count-byte
  (Pi ((cap 0 Type) (text TextView) (needle U8)) (Eff cap cap U64)))

(def
  text-count-byte
  (fn
    ((cap 0 Type) (text TextView) (needle U8))
    (byte-slice-count-byte
      cap
      (byte-slice-from (text-base text) (text-len text))
      needle)))

(claim text-count-lf (Pi ((cap 0 Type) (text TextView)) (Eff cap cap U64)))

(def
  text-count-lf
  (fn ((cap 0 Type) (text TextView)) (text-count-byte cap text (u8 10))))

(claim
  text-find-text
  (Pi ((cap 0 Type) (text TextView) (needle TextView)) (Eff cap cap ByteFindResult)))

(def
  text-find-text
  (fn
    ((cap 0 Type) (text TextView) (needle TextView))
    (byte-slice-find-slice
      cap
      (byte-slice-from (text-base text) (text-len text))
      (byte-slice-from (text-base needle) (text-len needle)))))

(claim
  text-contains-text
  (Pi ((cap 0 Type) (text TextView) (needle TextView)) (Eff cap cap Bool)))

(def
  text-contains-text
  (fn
    ((cap 0 Type) (text TextView) (needle TextView))
    (byte-slice-contains-slice
      cap
      (byte-slice-from (text-base text) (text-len text))
      (byte-slice-from (text-base needle) (text-len needle)))))
