; TextView is a byte view with an explicit unchecked text boundary.

; No UTF-8 validation or string literal surface is claimed yet.

(layout TextView 16 8 ((base (Ptr U8) 0) (len U64 8)))

(claim text-view-from (Pi ((base (Ptr U8)) (len U64)) TextView))

(def text-view-from (fn ((base (Ptr U8)) (len U64)) (layout-values TextView base len)))

(claim text-from-bytes (Pi ((bytes ByteSlice)) TextView))

(def
  text-from-bytes
  (fn
    ((bytes ByteSlice))
    (text-view-from (byte-slice-base bytes) (byte-slice-len bytes))))

(claim text-base (Pi ((text TextView)) (Ptr U8)))

(def text-base (fn ((text TextView)) (field TextView base text)))

(claim text-len (Pi ((text TextView)) U64))

(def text-len (fn ((text TextView)) (field TextView len text)))

(claim text-byte-at (Pi ((text TextView) (index U64)) (Ptr U8)))

(def
  text-byte-at
  (fn ((text TextView) (index U64)) (ptr-step U8 (text-base text) index)))

(claim text-is-empty (Pi ((text TextView)) Bool))

(def text-is-empty (fn ((text TextView)) (u64-eq (text-len text) (u64 0))))

(claim text-take (Pi ((text TextView) (count U64)) TextView))

(def
  text-take
  (fn
    ((text TextView) (count U64))
    (text-from-bytes
      (byte-slice-take (byte-slice-from (text-base text) (text-len text)) count))))

(claim text-drop (Pi ((text TextView) (count U64)) TextView))

(def
  text-drop
  (fn
    ((text TextView) (count U64))
    (text-from-bytes
      (byte-slice-drop (byte-slice-from (text-base text) (text-len text)) count))))

(claim text-eq (Pi ((cap 0 Type) (left TextView) (right TextView)) (Eff cap cap Bool)))

(def
  text-eq
  (fn
    ((cap 0 Type) (left TextView) (right TextView))
    (byte-slice-eq
      cap
      (byte-slice-from (text-base left) (text-len left))
      (byte-slice-from (text-base right) (text-len right)))))

(claim
  text-starts-with
  (Pi ((cap 0 Type) (text TextView) (prefix TextView)) (Eff cap cap Bool)))

(def
  text-starts-with
  (fn
    ((cap 0 Type) (text TextView) (prefix TextView))
    (byte-slice-starts-with
      cap
      (byte-slice-from (text-base text) (text-len text))
      (byte-slice-from (text-base prefix) (text-len prefix)))))
