; Hosted file-copy example.

; Usage: hosted-copy INPUT OUTPUT

; The program reads INPUT, writes the same bytes to OUTPUT, returns 0 on

; success, and reports narrow failure paths on stderr.

(static-bytes
  hosted-copy-usage-bytes
  ((u8 117)
   (u8 115)
   (u8 97)
   (u8 103)
   (u8 101)
   (u8 58)
   (u8 32)
   (u8 104)
   (u8 111)
   (u8 115)
   (u8 116)
   (u8 101)
   (u8 100)
   (u8 45)
   (u8 99)
   (u8 111)
   (u8 112)
   (u8 121)
   (u8 32)
   (u8 73)
   (u8 78)
   (u8 80)
   (u8 85)
   (u8 84)
   (u8 32)
   (u8 79)
   (u8 85)
   (u8 84)
   (u8 80)
   (u8 85)
   (u8 84)
   (u8 10)))

(static-bytes
  hosted-copy-read-failed-bytes
  ((u8 101)
   (u8 114)
   (u8 114)
   (u8 111)
   (u8 114)
   (u8 58)
   (u8 32)
   (u8 114)
   (u8 101)
   (u8 97)
   (u8 100)
   (u8 32)
   (u8 102)
   (u8 97)
   (u8 105)
   (u8 108)
   (u8 101)
   (u8 100)
   (u8 10)))

(static-bytes
  hosted-copy-write-failed-bytes
  ((u8 101)
   (u8 114)
   (u8 114)
   (u8 111)
   (u8 114)
   (u8 58)
   (u8 32)
   (u8 119)
   (u8 114)
   (u8 105)
   (u8 116)
   (u8 101)
   (u8 32)
   (u8 102)
   (u8 97)
   (u8 105)
   (u8 108)
   (u8 101)
   (u8 100)
   (u8 10)))

(claim hosted-copy-usage-text TextView)

(def
  hosted-copy-usage-text
  (text-view-from hosted-copy-usage-bytes hosted-copy-usage-bytes-len))

(claim hosted-copy-read-failed-text TextView)

(def
  hosted-copy-read-failed-text
  (text-view-from hosted-copy-read-failed-bytes hosted-copy-read-failed-bytes-len))

(claim hosted-copy-write-failed-text TextView)

(def
  hosted-copy-write-failed-text
  (text-view-from hosted-copy-write-failed-bytes hosted-copy-write-failed-bytes-len))

(claim hosted-copy-ok U64)

(def hosted-copy-ok (u64 0))

(claim hosted-copy-missing-args U64)

(def hosted-copy-missing-args (u64 2))

(claim hosted-copy-write-failed U64)

(def hosted-copy-write-failed (u64 3))

(claim hosted-copy-read-failed U64)

(def hosted-copy-read-failed (u64 6))

(claim
  hosted-copy-diagnostic
  (Pi ((message TextView) (status U64)) (Eff HostIO HostIO U64)))

(def hosted-copy-diagnostic host-status-with-error-text)

(claim
  hosted-copy-write
  (Pi ((output-path TextView) (body TextView)) (Eff HostIO HostIO U64)))

(def
  hosted-copy-write
  (fn
    ((output-path TextView) (body TextView))
    (bind
      HostIO
      HostIO
      HostIO
      Bool
      U64
      (host-write-file output-path body)
      (fn
        ((written 1 Bool))
        (if
          written
          (pure HostIO U64 hosted-copy-ok)
          (hosted-copy-diagnostic
            hosted-copy-write-failed-text
            hosted-copy-write-failed))))))

(claim hosted-copy-main (Eff HostIO HostIO U64))

(def
  hosted-copy-main
  (bind
    HostIO
    HostIO
    HostIO
    U64
    U64
    host-arg-count
    (fn
      ((count 1 U64))
      (if
        (u64-eq count (u64 3))
        (bind
          HostIO
          HostIO
          HostIO
          TextView
          U64
          (host-arg-text (u64 1))
          (fn
            ((input-path 1 TextView))
            (bind
              HostIO
              HostIO
              HostIO
              TextView
              U64
              (host-arg-text (u64 2))
              (fn
                ((output-path 1 TextView))
                (bind
                  HostIO
                  HostIO
                  HostIO
                  HostReadFileResult
                  U64
                  (host-read-file-result input-path)
                  (fn
                    ((read-result 1 HostReadFileResult))
                    (let-layout
                      HostReadFileResult
                      ((ok read-ok) (text body))
                      read-result
                      (if
                        read-ok
                        (hosted-copy-write output-path body)
                        (hosted-copy-diagnostic
                          hosted-copy-read-failed-text
                          hosted-copy-read-failed)))))))))
        (hosted-copy-diagnostic hosted-copy-usage-text hosted-copy-missing-args)))))
