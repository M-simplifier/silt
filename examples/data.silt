; Parametric and recursive algebraic data examples for stage0.

(data Option ((A 0 Type)) (None) (Some A))

(claim unwrap-or (Pi ((A 0 Type) (fallback A) (opt (Option A))) A))

(def
  unwrap-or
  (fn
    ((A 0 Type) (fallback A) (opt (Option A)))
    (match opt ((None) fallback) ((Some value) value))))

(claim picked Nat)

(def picked (unwrap-or Nat (S Z) (Some Nat Z)))

(data StageList ((A 0 Type)) (StageNil) (StageCons A (StageList A)))

(claim head-or (Pi ((A 0 Type) (fallback A) (xs (StageList A))) A))

(def
  head-or
  (fn
    ((A 0 Type) (fallback A) (xs (StageList A)))
    (match xs ((StageNil) fallback) ((StageCons head tail) head))))

(claim picked-head Nat)

(def picked-head (head-or Nat (S Z) (StageCons Nat Z (StageNil Nat))))
