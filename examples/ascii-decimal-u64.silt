(claim ascii-decimal-empty-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-empty-result
  (byte-slice-parse-ascii-u64 HostIO ascii-decimal-empty-view))

(claim ascii-decimal-text-result (Eff HostIO HostIO AsciiDecimalU64))

(def ascii-decimal-text-result (text-parse-ascii-u64 HostIO ascii-decimal-text-view))

(claim ascii-decimal-text-leading-zero-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-text-leading-zero-result
  (text-parse-ascii-u64 HostIO ascii-decimal-text-leading-zero-view))

(claim ascii-decimal-text-max-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-text-max-result
  (text-parse-ascii-u64 HostIO ascii-decimal-text-max-view))

(claim ascii-decimal-text-overflow-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-text-overflow-result
  (text-parse-ascii-u64 HostIO ascii-decimal-text-overflow-view))

(claim ascii-decimal-text-empty-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-text-empty-result
  (text-parse-ascii-u64 HostIO ascii-decimal-text-empty-view))

(claim ascii-decimal-text-invalid-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-text-invalid-result
  (text-parse-ascii-u64 HostIO ascii-decimal-text-invalid-view))

(claim
  ascii-decimal-effect-and
  (Pi
    ((left 1 (Eff HostIO HostIO Bool)) (right 1 (Eff HostIO HostIO Bool)))
    (Eff HostIO HostIO Bool)))

(def
  ascii-decimal-effect-and
  (fn
    ((left 1 (Eff HostIO HostIO Bool)) (right 1 (Eff HostIO HostIO Bool)))
    (bind
      HostIO
      HostIO
      HostIO
      Bool
      Bool
      left
      (fn
        ((left-value 1 Bool))
        (bind
          HostIO
          HostIO
          HostIO
          Bool
          Bool
          right
          (fn
            ((right-value 1 Bool))
            (pure HostIO Bool (bool-and left-value right-value))))))))

(claim ascii-decimal-small-test (Eff HostIO HostIO Bool))

(def
  ascii-decimal-small-test
  (bind
    HostIO
    HostIO
    HostIO
    AsciiDecimalU64
    Bool
    ascii-decimal-small-result
    (fn
      ((result 1 AsciiDecimalU64))
      (pure HostIO Bool (ascii-decimal-u64-has-value result (u64 12345))))))

