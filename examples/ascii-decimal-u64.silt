; ASCII decimal U64 parsing examples over explicit byte-backed views.

; Empty input, non-digits, and overflow are rejected.

(static-bytes ascii-decimal-small-bytes ((u8 49) (u8 50) (u8 51) (u8 52) (u8 53)))

(static-bytes
  ascii-decimal-leading-zero-bytes
  ((u8 48) (u8 48) (u8 48) (u8 52) (u8 50)))

(static-bytes ascii-decimal-invalid-bytes ((u8 49) (u8 50) (u8 65) (u8 51)))

(static-bytes
  ascii-decimal-max-bytes
  ((u8 49)
   (u8 56)
   (u8 52)
   (u8 52)
   (u8 54)
   (u8 55)
   (u8 52)
   (u8 52)
   (u8 48)
   (u8 55)
   (u8 51)
   (u8 55)
   (u8 48)
   (u8 57)
   (u8 53)
   (u8 53)
   (u8 49)
   (u8 54)
   (u8 49)
   (u8 53)))

(static-bytes
  ascii-decimal-overflow-bytes
  ((u8 49)
   (u8 56)
   (u8 52)
   (u8 52)
   (u8 54)
   (u8 55)
   (u8 52)
   (u8 52)
   (u8 48)
   (u8 55)
   (u8 51)
   (u8 55)
   (u8 48)
   (u8 57)
   (u8 53)
   (u8 53)
   (u8 49)
   (u8 54)
   (u8 49)
   (u8 54)))

(static-bytes ascii-decimal-text-bytes ((u8 52) (u8 50)))

(claim ascii-decimal-small-view ByteSlice)

(def
  ascii-decimal-small-view
  (byte-slice-from ascii-decimal-small-bytes ascii-decimal-small-bytes-len))

(claim ascii-decimal-leading-zero-view ByteSlice)

(def
  ascii-decimal-leading-zero-view
  (byte-slice-from
    ascii-decimal-leading-zero-bytes
    ascii-decimal-leading-zero-bytes-len))

(claim ascii-decimal-invalid-view ByteSlice)

(def
  ascii-decimal-invalid-view
  (byte-slice-from ascii-decimal-invalid-bytes ascii-decimal-invalid-bytes-len))

(claim ascii-decimal-max-view ByteSlice)

(def
  ascii-decimal-max-view
  (byte-slice-from ascii-decimal-max-bytes ascii-decimal-max-bytes-len))

(claim ascii-decimal-overflow-view ByteSlice)

(def
  ascii-decimal-overflow-view
  (byte-slice-from ascii-decimal-overflow-bytes ascii-decimal-overflow-bytes-len))

(claim ascii-decimal-empty-view ByteSlice)

(def ascii-decimal-empty-view (byte-slice-from ascii-decimal-small-bytes (u64 0)))

(claim ascii-decimal-text-view TextView)

(def
  ascii-decimal-text-view
  (text-view-from ascii-decimal-text-bytes ascii-decimal-text-bytes-len))

(claim ascii-decimal-text-leading-zero-view TextView)

(def
  ascii-decimal-text-leading-zero-view
  (text-view-from ascii-decimal-leading-zero-bytes ascii-decimal-leading-zero-bytes-len))

(claim ascii-decimal-text-max-view TextView)

(def
  ascii-decimal-text-max-view
  (text-view-from ascii-decimal-max-bytes ascii-decimal-max-bytes-len))

(claim ascii-decimal-text-overflow-view TextView)

(def
  ascii-decimal-text-overflow-view
  (text-view-from ascii-decimal-overflow-bytes ascii-decimal-overflow-bytes-len))

(claim ascii-decimal-text-empty-view TextView)

(def ascii-decimal-text-empty-view (text-view-from ascii-decimal-text-bytes (u64 0)))

(claim ascii-decimal-text-invalid-view TextView)

(def
  ascii-decimal-text-invalid-view
  (text-view-from ascii-decimal-invalid-bytes ascii-decimal-invalid-bytes-len))

(claim ascii-decimal-small-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-small-result
  (byte-slice-parse-ascii-u64 HostIO ascii-decimal-small-view))

(claim ascii-decimal-leading-zero-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-leading-zero-result
  (byte-slice-parse-ascii-u64 HostIO ascii-decimal-leading-zero-view))

(claim ascii-decimal-invalid-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-invalid-result
  (byte-slice-parse-ascii-u64 HostIO ascii-decimal-invalid-view))

(claim ascii-decimal-max-result (Eff HostIO HostIO AsciiDecimalU64))

(def
  ascii-decimal-max-result
