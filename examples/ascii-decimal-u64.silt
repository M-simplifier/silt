(claim ascii-decimal-u64-test (Eff HostIO HostIO Bool))

(def
  ascii-decimal-u64-test
  (ascii-decimal-effect-and
    ascii-decimal-small-test
    (ascii-decimal-effect-and
      ascii-decimal-leading-zero-test
      (ascii-decimal-effect-and
        ascii-decimal-max-test
        (ascii-decimal-effect-and
          ascii-decimal-invalid-test
          (ascii-decimal-effect-and
            ascii-decimal-overflow-test
            (ascii-decimal-effect-and
              ascii-decimal-empty-test
              (ascii-decimal-effect-and
                ascii-decimal-text-test
                (ascii-decimal-effect-and
                  ascii-decimal-text-leading-zero-test
                  (ascii-decimal-effect-and
                    ascii-decimal-text-max-test
                    (ascii-decimal-effect-and
                      ascii-decimal-text-overflow-test
                      (ascii-decimal-effect-and
                        ascii-decimal-text-empty-test
                        ascii-decimal-text-invalid-test))))))))))))
