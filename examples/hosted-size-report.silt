   (u8 79)
   (u8 85)
   (u8 84)
   (u8 80)
   (u8 85)
   (u8 84)
   (u8 10)))

(static-bytes
  hosted-size-report-read-failed-bytes
  ((u8 101)
   (u8 114)
   (u8 114)
   (u8 111)
   (u8 114)
   (u8 58)
   (u8 32)
   (u8 114)
   (u8 101)
   (u8 97)
   (u8 100)
   (u8 32)
   (u8 102)
   (u8 97)
   (u8 105)
   (u8 108)
   (u8 101)
   (u8 100)
   (u8 10)))

(static-bytes
  hosted-size-report-invalid-expected-bytes
  ((u8 101)
   (u8 114)
   (u8 114)
   (u8 111)
   (u8 114)
   (u8 58)
   (u8 32)
   (u8 105)
   (u8 110)
   (u8 118)
   (u8 97)
   (u8 108)
   (u8 105)
   (u8 100)
   (u8 32)
   (u8 101)
   (u8 120)
   (u8 112)
   (u8 101)
   (u8 99)
   (u8 116)
   (u8 101)
   (u8 100)
   (u8 32)
   (u8 108)
   (u8 101)
   (u8 110)
   (u8 103)
   (u8 116)
   (u8 104)
   (u8 10)))

(static-bytes
  hosted-size-report-write-failed-bytes
  ((u8 101)
   (u8 114)
   (u8 114)
   (u8 111)
   (u8 114)
   (u8 58)
   (u8 32)
   (u8 119)
   (u8 114)
   (u8 105)
   (u8 116)
   (u8 101)
   (u8 32)
   (u8 102)
   (u8 97)
   (u8 105)
   (u8 108)
   (u8 101)
   (u8 100)
   (u8 10)))

(static-bytes
  hosted-size-report-mismatch-bytes
  ((u8 101)
   (u8 114)
   (u8 114)
   (u8 111)
   (u8 114)
   (u8 58)
   (u8 32)
   (u8 108)
   (u8 101)
   (u8 110)
   (u8 103)
   (u8 116)
   (u8 104)
   (u8 32)
   (u8 109)
   (u8 105)
   (u8 115)
   (u8 109)
   (u8 97)
   (u8 116)
   (u8 99)
   (u8 104)
   (u8 10)))

(claim hosted-size-report-usage-text TextView)

(def
  hosted-size-report-usage-text
  (text-view-from hosted-size-report-usage-bytes hosted-size-report-usage-bytes-len))

(claim hosted-size-report-read-failed-text TextView)

(def
  hosted-size-report-read-failed-text
  (text-view-from
    hosted-size-report-read-failed-bytes
    hosted-size-report-read-failed-bytes-len))

(claim hosted-size-report-invalid-expected-text TextView)

(def
  hosted-size-report-invalid-expected-text
  (text-view-from
    hosted-size-report-invalid-expected-bytes
    hosted-size-report-invalid-expected-bytes-len))

(claim hosted-size-report-write-failed-text TextView)

(def
  hosted-size-report-write-failed-text
  (text-view-from
    hosted-size-report-write-failed-bytes
    hosted-size-report-write-failed-bytes-len))

(claim hosted-size-report-mismatch-text TextView)

(def
  hosted-size-report-mismatch-text
  (text-view-from
    hosted-size-report-mismatch-bytes
    hosted-size-report-mismatch-bytes-len))

(claim hosted-size-report-ok U64)

(def hosted-size-report-ok (u64 0))

(claim hosted-size-report-missing-args U64)

(def hosted-size-report-missing-args (u64 2))

(claim hosted-size-report-write-failed U64)

(def hosted-size-report-write-failed (u64 3))

(claim hosted-size-report-invalid-expected U64)

(def hosted-size-report-invalid-expected (u64 4))

(claim hosted-size-report-mismatch U64)

(def hosted-size-report-mismatch (u64 5))

(claim hosted-size-report-read-failed U64)

(def hosted-size-report-read-failed (u64 6))

(claim
  hosted-size-report-diagnostic
  (Pi ((message TextView) (status U64)) (Eff HostIO HostIO U64)))

(def
  hosted-size-report-diagnostic
  (fn
    ((message TextView) (status U64))
    (bind
      HostIO
      HostIO
      HostIO
      Unit
      U64
      (host-write-error-text message)
      (fn ((done 1 Unit)) (let ((ignored 0 done)) (pure HostIO U64 status))))))

(claim
  hosted-size-report-finish-status
  (Pi ((expected U64) (actual U64)) (Eff HostIO HostIO U64)))

(def
  hosted-size-report-finish-status
  (fn
    ((expected U64) (actual U64))
    (match
      (u64-eq expected actual)
      ((False)
       (hosted-size-report-diagnostic
         hosted-size-report-mismatch-text
         hosted-size-report-mismatch))
      ((True) (pure HostIO U64 hosted-size-report-ok)))))

(claim
  hosted-size-report-evaluate
  (Pi
    ((expected-base (Ptr U8))
     (expected-len U64)
     (output-base (Ptr U8))
     (output-len U64)
     (actual-len U64))
    (Eff HostIO HostIO U64)))

(def
  hosted-size-report-evaluate
  (fn
    ((expected-base (Ptr U8))
     (expected-len U64)
     (output-base (Ptr U8))
     (output-len U64)
     (actual-len U64))
    (bind
      HostIO
      HostIO
      HostIO
      AsciiDecimalU64
      U64
      (text-parse-ascii-u64 HostIO (text-view-from expected-base expected-len))
      (fn
        ((parsed 1 AsciiDecimalU64))
        (let-layout
          AsciiDecimalU64
          ((valid expected-valid) (value expected-value))
          parsed
          (match
            expected-valid
            ((False)
             (hosted-size-report-diagnostic
               hosted-size-report-invalid-expected-text
               hosted-size-report-invalid-expected))
            ((True)
             (bind
               HostIO
               HostIO
               HostIO
               TextView
               U64
               (ascii-decimal-u64-format-into
                 HostIO
                 hosted-size-report-file-buffer
                 actual-len)
               (fn
                 ((file-text 1 TextView))
                 (bind
                   HostIO
                   HostIO
                   HostIO
                   Bool
                   U64
                   (host-write-file (text-view-from output-base output-len) file-text)
                   (fn
                     ((written 1 Bool))
                     (match
                       written
                       ((False)
                        (hosted-size-report-diagnostic
                          hosted-size-report-write-failed-text
                          hosted-size-report-write-failed))
                       ((True)
                        (bind
                          HostIO
                          HostIO
                          HostIO
                          TextView
                          U64
                          (ascii-decimal-u64-format-into
                            HostIO
                            hosted-size-report-stdout-buffer
                            actual-len)
                          (fn
                            ((stdout-text 1 TextView))
                            (bind
                              HostIO
                              HostIO
                              HostIO
                              Unit
                              U64
                              (host-write-text stdout-text)
                              (fn
                                ((done 1 Unit))
                                (let
                                  ((ignored 0 done))
                                  (hosted-size-report-finish-status
                                    expected-value
                                    actual-len)))))))))))))))))))

(claim hosted-size-report-main (Eff HostIO HostIO U64))

(def
  hosted-size-report-main
  (bind
    HostIO
    HostIO
    HostIO
    U64
    U64
    host-arg-count
    (fn
      ((count 1 U64))
      (match
        (u64-eq count (u64 4))
        ((False)
         (hosted-size-report-diagnostic
           hosted-size-report-usage-text
           hosted-size-report-missing-args))
        ((True)
         (bind
           HostIO
           HostIO
           HostIO
           TextView
           U64
           (host-arg-text (u64 1))
           (fn
             ((input-path 1 TextView))
             (bind
               HostIO
               HostIO
               HostIO
               TextView
               U64
               (host-arg-text (u64 2))
               (fn
                 ((expected-text 1 TextView))
                 (let-layout
                   TextView
                   ((base expected-base) (len expected-len))
                   expected-text
                   (bind
                     HostIO
                     HostIO
                     HostIO
                     TextView
                     U64
                     (host-arg-text (u64 3))
                     (fn
                       ((output-path 1 TextView))
                       (let-layout
                         TextView
                         ((base output-base) (len output-len))
                         output-path
                         (bind
                           HostIO
                           HostIO
                           HostIO
                           HostReadFileResult
                           U64
                           (host-read-file-result input-path)
                           (fn
                             ((read-result 1 HostReadFileResult))
                             (let-layout
                               HostReadFileResult
                               ((ok read-ok) (text body))
                               read-result
                               (match
                                 read-ok
                                 ((False)
                                  (hosted-size-report-diagnostic
                                    hosted-size-report-read-failed-text
                                    hosted-size-report-read-failed))
                                 ((True)
                                  (let-layout
                                    TextView
                                    ((base 0 ignored-body-base) (len actual-len))
                                    body
                                    (hosted-size-report-evaluate
                                      expected-base
                                      expected-len
                                      output-base
                                      output-len
                                      actual-len))))))))))))))))))))
