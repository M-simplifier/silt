; Hosted CLI pressure example.

; Usage: hosted-size-report INPUT EXPECTED_LEN OUTPUT

; The program reads INPUT, parses EXPECTED_LEN as ASCII decimal U64, writes the

; actual byte length to OUTPUT and stdout, returns 0 on match, and reports

; failure paths on stderr.

(static-cell hosted-size-report-file-buffer AsciiDecimalU64Buffer)

(static-cell hosted-size-report-stdout-buffer AsciiDecimalU64Buffer)

(static-bytes
  hosted-size-report-usage-bytes
  ((u8 117)
   (u8 115)
   (u8 97)
   (u8 103)
   (u8 101)
   (u8 58)
   (u8 32)
   (u8 104)
   (u8 111)
   (u8 115)
   (u8 116)
   (u8 101)
   (u8 100)
   (u8 45)
   (u8 115)
   (u8 105)
   (u8 122)
   (u8 101)
   (u8 45)
   (u8 114)
   (u8 101)
   (u8 112)
   (u8 111)
   (u8 114)
   (u8 116)
   (u8 32)
   (u8 73)
   (u8 78)
   (u8 80)
   (u8 85)
   (u8 84)
   (u8 32)
   (u8 69)
   (u8 88)
   (u8 80)
   (u8 69)
   (u8 67)
   (u8 84)
   (u8 69)
