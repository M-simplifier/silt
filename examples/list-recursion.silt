; Closed List structural-recursion examples over the total core surface.

; These examples use list-elim through stdlib helpers. They do not claim

; unrestricted recursion or a runtime representation for generic lists.

(claim list-recursion-values (List U64))

(def
  list-recursion-values
  (Cons U64 (u64 1) (Cons U64 (u64 2) (Cons U64 (u64 3) (Nil U64)))))

(claim list-recursion-length-three U64)

(def list-recursion-length-three (nat-to-word (list-length U64 list-recursion-values)))

(claim list-recursion-length-empty U64)

(def list-recursion-length-empty (nat-to-word (list-length U64 (Nil U64))))

(claim list-recursion-fold-sum U64)

(def
  list-recursion-fold-sum
  (list-fold-right
    U64
    U64
    (u64 0)
    (fn ((head U64) (rec U64)) (u64-add head rec))
    list-recursion-values))

(claim list-recursion-map-head U64)

(def
  list-recursion-map-head
  (list-head-or
    U64
    (u64 0)
    (list-map U64 U64 (fn ((value U64)) (u64-add value (u64 10))) list-recursion-values)))

(claim list-recursion-test Bool)

(def
  list-recursion-test
  (bool-and
    (u64-eq list-recursion-length-three (u64 3))
    (bool-and
      (u64-eq list-recursion-length-empty (u64 0))
      (bool-and
        (u64-eq list-recursion-fold-sum (u64 6))
        (u64-eq list-recursion-map-head (u64 11))))))
