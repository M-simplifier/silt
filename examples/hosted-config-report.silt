; Hosted config-reading CLI pressure example.

; Usage: hosted-config-report INPUT CONFIG OUTPUT

; CONFIG is a one-entry ASCII text file shaped like: expected: 8

; The program reads INPUT and CONFIG, trims the split config fields, parses the

; expected length as ASCII decimal U64, writes the actual byte length to OUTPUT

; and stdout, returns 0 on match, and reports failure paths on stderr.

(static-cell hosted-config-report-file-buffer AsciiDecimalU64Buffer)

(static-cell hosted-config-report-stdout-buffer AsciiDecimalU64Buffer)

(static-bytes
  hosted-config-report-key-bytes
  ((u8 101) (u8 120) (u8 112) (u8 101) (u8 99) (u8 116) (u8 101) (u8 100)))

