(claim hosted-config-report-key-text TextView)

(def
  hosted-config-report-key-text
  (text-view-from hosted-config-report-key-bytes hosted-config-report-key-bytes-len))

(claim hosted-config-report-usage-text TextView)

(def
  hosted-config-report-usage-text
  (text-view-from hosted-config-report-usage-bytes hosted-config-report-usage-bytes-len))

(claim hosted-config-report-input-read-failed-text TextView)

(def
  hosted-config-report-input-read-failed-text
  (text-view-from
    hosted-config-report-input-read-failed-bytes
    hosted-config-report-input-read-failed-bytes-len))

