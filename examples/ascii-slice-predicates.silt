(static-bytes ascii-slice-hex-bytes ((u8 48) (u8 57) (u8 65) (u8 70) (u8 97) (u8 102)))

(static-bytes ascii-slice-hex-mixed-bytes ((u8 48) (u8 57) (u8 71) (u8 102)))

(static-bytes ascii-slice-whitespace-bytes ((u8 9) (u8 10) (u8 13) (u8 32)))

(static-bytes ascii-slice-whitespace-letter-bytes ((u8 9) (u8 32) (u8 65)))

