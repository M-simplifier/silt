; ASCII slice predicate examples over explicit byte-backed views.

; Empty inputs are accepted by the all-* predicates. Use byte-slice-is-empty

; or text-is-empty when a non-empty token is required.

(static-bytes ascii-slice-digit-bytes ((u8 49) (u8 50) (u8 51) (u8 57)))

(static-bytes ascii-slice-digit-mixed-bytes ((u8 49) (u8 50) (u8 65) (u8 51)))

(static-bytes
  ascii-slice-alnum-bytes
  ((u8 83) (u8 105) (u8 108) (u8 116) (u8 52) (u8 50)))

(static-bytes
