(claim
  ascii-effect-and
  (Pi
    ((left 1 (Eff HostIO HostIO Bool)) (right 1 (Eff HostIO HostIO Bool)))
    (Eff HostIO HostIO Bool)))

(def
  ascii-effect-and
  (fn
    ((left 1 (Eff HostIO HostIO Bool)) (right 1 (Eff HostIO HostIO Bool)))
    (bind
      HostIO
      HostIO
      HostIO
      Bool
      Bool
      left
      (fn
        ((left-value 1 Bool))
        (bind
          HostIO
          HostIO
          HostIO
          Bool
          Bool
          right
          (fn
            ((right-value 1 Bool))
            (pure HostIO Bool (bool-and left-value right-value))))))))

(claim
  ascii-effect-not
  (Pi ((value 1 (Eff HostIO HostIO Bool))) (Eff HostIO HostIO Bool)))

(def
  ascii-effect-not
  (fn
    ((value 1 (Eff HostIO HostIO Bool)))
    (bind
      HostIO
      HostIO
      HostIO
      Bool
      Bool
      value
      (fn ((inner 1 Bool)) (pure HostIO Bool (bool-not inner))))))

(claim ascii-slice-byte-empty-predicate-test (Eff HostIO HostIO Bool))

(def
  ascii-slice-byte-empty-predicate-test
  (ascii-effect-and
    ascii-slice-empty-result
    (ascii-effect-and
      ascii-slice-empty-alnum-result
      (ascii-effect-and
        ascii-slice-empty-hex-result
        ascii-slice-empty-whitespace-result))))

(claim ascii-slice-text-empty-predicate-test (Eff HostIO HostIO Bool))

(def
  ascii-slice-text-empty-predicate-test
  (ascii-effect-and
    ascii-text-empty-digits-result
    (ascii-effect-and
      ascii-text-empty-alnum-result
      (ascii-effect-and ascii-text-empty-hex-result ascii-text-empty-result))))

(claim ascii-slice-byte-predicate-test (Eff HostIO HostIO Bool))

(def
  ascii-slice-byte-predicate-test
  (ascii-effect-and
    ascii-slice-digits-result
    (ascii-effect-and
      (ascii-effect-not ascii-slice-digits-mixed-result)
      (ascii-effect-and
        ascii-slice-alnum-result
        (ascii-effect-and
          (ascii-effect-not ascii-slice-alnum-symbol-result)
          (ascii-effect-and
            ascii-slice-hex-result
            (ascii-effect-and
              (ascii-effect-not ascii-slice-hex-mixed-result)
              (ascii-effect-and
                ascii-slice-whitespace-result
                (ascii-effect-and
                  (ascii-effect-not ascii-slice-whitespace-letter-result)
                  ascii-slice-byte-empty-predicate-test)))))))))

(claim ascii-slice-text-predicate-test (Eff HostIO HostIO Bool))

(def
  ascii-slice-text-predicate-test
  (ascii-effect-and
    ascii-text-digits-result
    (ascii-effect-and
      (ascii-effect-not ascii-text-digits-mixed-result)
      (ascii-effect-and
        ascii-text-alnum-result
        (ascii-effect-and
          (ascii-effect-not ascii-text-alnum-symbol-result)
          (ascii-effect-and
            ascii-text-hex-result
            (ascii-effect-and
              (ascii-effect-not ascii-text-hex-mixed-result)
              (ascii-effect-and
                ascii-text-whitespace-result
                (ascii-effect-and
                  (ascii-effect-not ascii-text-whitespace-letter-result)
                  ascii-slice-text-empty-predicate-test)))))))))

(claim ascii-slice-predicate-test (Eff HostIO HostIO Bool))

(def
  ascii-slice-predicate-test
  (ascii-effect-and ascii-slice-byte-predicate-test ascii-slice-text-predicate-test))
